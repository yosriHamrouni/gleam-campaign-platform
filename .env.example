# Copy to .env and adjust.
PORT=3009
MONGO_URI=mongodb://127.0.0.1:27017/gleam
# Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Public URL of the React app (share links and CORS)
CLIENT_URL=http://localhost:3008
